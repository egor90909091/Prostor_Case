# Все переменные опциональны: без них прототип поднимается на заглушках
# и проходит сценарий целиком, не обращаясь во внешнюю сеть.

# PostgreSQL. Значения по умолчанию (prostor/prostor) годятся только для
# локального прототипа — при выкладке куда-то дальше localhost задайте свои.
POSTGRES_USER=prostor
POSTGRES_PASSWORD=prostor
POSTGRES_DB=prostor

# LLM (чат): любой OpenAI-совместимый chat/completions endpoint. Сейчас — DeepSeek.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
# true -> JSON-вызовы (экстракция полей ТЗ из диалога, ИИ-ревью черновика) идут
# со строгой response_format json_schema. 
# Клиент сам откатится на json_object при отказе, а битый JSON чинит повторным вызовом.
# true имеет смысл для OpenAI / vLLM и прочих провайдеров со Structured Outputs.
LLM_STRUCTURED_OUTPUTS=false

# Эмбеддинги: bge-m3 через Ollama, вне docker —
# `ollama pull bge-m3`.
EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024


# false переводит ход на детерминированную ветку: без выбранной услуги любой
# текст считается поиском, с выбранной — ответ собирается из состояния заявки.
# То же самое происходит на LLM-заглушке (без ключа). Имя переменной оставлено

ENABLE_ROUTER=true

# Таймауты чата. LLM_TIMEOUT_SECONDS — потолок одного вызова модели: 
# TURN_TIMEOUT_SECONDS —страховка на ход целиком; 
# 2 x LLM_TIMEOUT_SECONDS — иначе ход рвётся посреди стрима и карточки услуг,

EMBEDDING_TIMEOUT_SECONDS=5
LLM_TIMEOUT_SECONDS=45
TURN_TIMEOUT_SECONDS=150

# Ранжирование поиска услуг (веса зашиты в поиске, не в env; без вектора —
# 0.20/0.25/0.10/0.05 по тем же каналам):
#   score = 0.75*смысл + 0.04*слова_в_названии + 0.07*слова_в_составе_работ
#         + 0.03*опечатки + 0.03*популярность; +0.04 если все слова запроса
#         совпали с названием; +1.0 при дословном совпадении названия.
#   Смысл и состав работ гасятся штрафом за неинформативность: чанк, дословно
#   общий у многих услуг, ничего не доказывает и почти не считается.
# Пороги «уверенно / похоже / не нашёл» решает код, не модель.
# Ориентиры: точный запрос ~0.69, своими словами ~0.55, шум ~0.35.

# Ниже — «не нашёл», карточек нет вовсе; поднять = меньше мусора, больше пустых ответов.
SEARCH_MIN_SCORE=0.20

# Выше — уверенная находка; между MIN_SCORE и этим — «догадка» с уточняющим вопросом.
SEARCH_CONFIDENT_SCORE=0.45

# Отрыв лидера от второго места: «балл в балл» у дубликатов = догадка. 0 = выключено.
SEARCH_MIN_MARGIN=0.005

# Планка близости по смыслу, когда совпавших слов нет совсем.
SEARCH_SEMANTIC_FLOOR=0.60

# MinIO
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# выгрузка в PDF отдаёт 503, а /health у tz показывает pdf=no-font.
# PDF_FONT_REGULAR=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# PDF_FONT_BOLD=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
